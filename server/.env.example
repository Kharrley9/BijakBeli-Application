# Copy to .env and fill in real values

# Environment
NODE_ENV=development
PORT=5000

# MongoDB — a free Atlas M0 cluster SRV string, or a local mongod
MONGO_URI=mongodb://localhost:27017/bijakbeli

# JWT
JWT_SECRET=change_me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Client URL (used for CORS in production)
CLIENT_URL=http://localhost:5173

# Travel-distance comparison
# Average driving speed (km/h) used to estimate drive time from straight-line distance
AVG_DRIVE_SPEED_KMH=35
# Distance provider: 'estimate' (offline haversine) or 'ors' (OpenRouteService, needs key)
ROUTING_PROVIDER=estimate
ROUTING_API_KEY=
# "Cheapest" is picked among stores within this many km of the buyer (all stores if none)
NEARBY_RADIUS_KM=30

# Travel cost (fuel): stores are also ranked by item price + round-trip fuel
# RON95 price in RM per litre (BUDI95 subsidised price is RM1.99; update if it changes)
FUEL_PRICE_RM=1.99
# Average fuel consumption, litres per 100 km
FUEL_L_PER_100KM_CAR=7.0
FUEL_L_PER_100KM_MOTORCYCLE=2.5

