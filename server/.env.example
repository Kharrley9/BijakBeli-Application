# Copy to .env and fill in real values

# Environment
NODE_ENV=development
PORT=5000

# MongoDB — a free Atlas M0 cluster SRV string, or a local mongod
MONGO_URI=mongodb://localhost:27017/bijakbeli

# JWT
JWT_SECRET=change_me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Client URL (used for CORS in production)
CLIENT_URL=http://localhost:5173

# Travel-distance comparison
# Town driving speed (km/h) for the first 5 km of the drive-time estimate (longer trips use 55, then 75 km/h)
AVG_DRIVE_SPEED_KMH=35
# Distance provider: 'estimate' (offline haversine) or 'ors' (OpenRouteService, needs key)
ROUTING_PROVIDER=estimate
ROUTING_API_KEY=
# "Cheapest" is picked among stores within this many km of the buyer (all stores if none)
NEARBY_RADIUS_KM=30

# Travel cost (fuel): stores are also ranked by item price + round-trip fuel
# RON95 price in RM per litre (BUDI95 subsidised price is RM1.99; update if it changes)
FUEL_PRICE_RM=1.99
# Average fuel consumption, litres per 100 km
FUEL_L_PER_100KM_CAR=7.0
FUEL_L_PER_100KM_MOTORCYCLE=2.5

# Daily price refresh from KPDN PriceCatcher (data.gov.my). The server re-imports once a
# day at this hour, Malaysia time (0-23), and catches up on start if the PC was off.
PRICE_IMPORT_ENABLED=true
PRICE_IMPORT_HOUR=21

# Photo scan: Google Gemini (free tier). Create a key at https://aistudio.google.com/apikey
# and copy YOUR project's free-tier limits from https://aistudio.google.com/rate-limit
# (they differ per model and Google changes them). Free-tier photos may be used by Google
# to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=15
GEMINI_RPD=500
