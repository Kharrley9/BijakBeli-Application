# Copy to .env and fill in real values

# Environment
NODE_ENV=development
PORT=5000

# MongoDB — a free Atlas M0 cluster SRV string, or a local mongod
MONGO_URI=mongodb://localhost:27017/bijakbeli

# JWT
JWT_SECRET=change_me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Client URL (used for CORS in production)
CLIENT_URL=http://localhost:5173

# Upload
MAX_FILE_UPLOAD=5000000
FILE_UPLOAD_PATH=./uploads

# Travel-distance comparison
# Average driving speed (km/h) used to estimate drive time from straight-line distance
AVG_DRIVE_SPEED_KMH=35
# Distance provider: 'estimate' (offline haversine) or 'ors' (OpenRouteService, needs key)
ROUTING_PROVIDER=estimate
ROUTING_API_KEY=
